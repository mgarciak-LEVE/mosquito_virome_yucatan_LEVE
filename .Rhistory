# Libraries
library(ggcoverage)
# Original genome-read mapping
depth_file <- "data/raw/czid_raw/mapping/OSFV/PM2528_S2_923330/PM2528_S2_923330_depth.txt"
depth_data <- read.table(depth_file, header=FALSE, col.names=c("contig", "position", "depth"))
# Small RNA mapping
smallrna_depth_file <- "results/czid/osfv_complete_genome/PM2528_S2_923330_depth.txt"
smallrna_depth_data <- read.table(depth_file, header=FALSE, col.names=c("contig", "position", "depth"))
# Covergae plots
before <- read.table(depth_data,
col.names=c("contig","pos","depth"))
before$stage <- "Before (CZID)"
after$stage <- "After (small RNA)"
# Original genome-read mapping
depth_file <- "data/raw/czid_raw/mapping/OSFV/PM2528_S2_923330/PM2528_S2_923330_depth.txt"
before <- read.table(depth_file, header=FALSE, col.names=c("contig", "pos", "depth"))
before$stage <- "Before (CZID)"
# Small RNA mapping
smallrna_file <- "results/czid/osfv_complete_genome/PM2528_S2_923330_depth.txt"
after <- read.table(smallrna_file, header=FALSE, col.names=c("contig", "pos", "depth"))
after$stage <- "After (small RNA)"
# Combine
combined <- rbind(before, after)
# Coverage plots
ggplot(combined, aes(x=pos, y=depth, fill=stage)) +
geom_area(alpha=0.5) +
facet_wrap(~stage, ncol=1, scales="free_y") +
labs(x="Genome Position (bp)", y="Coverage Depth (×)",
title="OSFV PM2528 Coverage: Before vs After Small RNA Mapping") +
theme_minimal()
